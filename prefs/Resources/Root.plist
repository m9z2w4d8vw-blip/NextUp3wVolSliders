<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>NextUp 3</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Turns NextUp 3 on or off everywhere.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Apps</string>
			<key>footerText</key>
			<string>Choose which apps show the Up Next row.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Apple Music</string>
			<key>key</key>
			<string>enabledMusic</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Podcasts</string>
			<key>key</key>
			<string>enabledPodcasts</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>YouTube Music</string>
			<key>key</key>
			<string>enabledYouTubeMusic</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Spotify</string>
			<key>key</key>
			<string>enabledSpotify</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Interfaces</string>
			<key>footerText</key>
			<string>Choose where the Up Next row appears.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Lock Screen</string>
			<key>key</key>
			<string>showLockScreen</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Dynamic Island</string>
			<key>key</key>
			<string>showDynamicIsland</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Control Center</string>
			<key>key</key>
			<string>showControlCenter</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Volume</string>
			<key>footerText</key>
			<string>Adds the volume slider to the Lock Screen player, the one Control Center already has. Apple only lays it out there while the session is on AirPlay; this unhides it for local playback too. If it stays missing, switch on the tweak's own slider below.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Volume Slider</string>
			<key>key</key>
			<string>showVolumeSlider</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Use NextUp's Own Slider</string>
			<key>key</key>
			<string>volumeSliderCustom</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Diagnostics</string>
			<key>footerText</key>
			<string>Collects the per-process logs and any recent crash reports into one text file and opens the share sheet, so it can be saved to Files or mailed. The logs need the DEBUG build of the tweak; crash reports are collected either way. Clear the log first, reproduce the problem, then export.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Skip Provider Init</string>
			<key>key</key>
			<string>skipProviders</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.yves.nextup3</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Export Debug Log</string>
			<key>action</key>
			<string>exportLog:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Clear Debug Log</string>
			<key>action</key>
			<string>clearLog:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Skip Provider Init leaves the tweak loaded but inert inside Music, Podcasts, YouTube Music and Spotify: no queue reading, no Up Next row. Turn it on if one of those apps crashes on launch — the app has to be relaunched for it to take effect. The Lock Screen volume slider is unaffected either way.</string>
		</dict>
	</array>
</dict>
</plist>
